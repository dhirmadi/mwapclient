{
  "MWAP React Component": {
    "prefix": "mwap-component",
    "body": [
      "import React from 'react';",
      "import { ${2:Button} } from '@mantine/core';",
      "",
      "interface ${1:ComponentName}Props {",
      "  ${3:// Props interface}",
      "}",
      "",
      "const ${1:ComponentName}: React.FC<${1:ComponentName}Props> = ({",
      "  ${4:// Destructured props}",
      "}) => {",
      "  ${5:// Component logic}",
      "",
      "  return (",
      "    <div>",
      "      ${6:// JSX content}",
      "    </div>",
      "  );",
      "};",
      "",
      "export default ${1:ComponentName};"
    ],
    "description": "MWAP Client React component template"
  },
  "MWAP Custom Hook": {
    "prefix": "mwap-hook",
    "body": [
      "import { ${2:useState} } from 'react';",
      "",
      "interface Use${1:HookName}Options {",
      "  ${3:// Options interface}",
      "}",
      "",
      "interface Use${1:HookName}Return {",
      "  ${4:// Return type interface}",
      "}",
      "",
      "const use${1:HookName} = (options: Use${1:HookName}Options): Use${1:HookName}Return => {",
      "  ${5:// Hook implementation}",
      "",
      "  return {",
      "    ${6:// Return object}",
      "  };",
      "};",
      "",
      "export default use${1:HookName};"
    ],
    "description": "MWAP Client custom hook template"
  },
  "MWAP React Query Hook": {
    "prefix": "mwap-query",
    "body": [
      "import { useQuery } from '@tanstack/react-query';",
      "import { apiClient } from '@/shared/utils/api';",
      "",
      "interface ${1:DataType} {",
      "  ${2:// Data interface}",
      "}",
      "",
      "const use${3:FeatureName}Data = (${4:id: string}) => {",
      "  return useQuery({",
      "    queryKey: ['${5:feature}', ${4:id}],",
      "    queryFn: async (): Promise<${1:DataType}> => {",
      "      const response = await apiClient.get(`/api/v1/${5:feature}/${${4:id}}`);",
      "      return response.data;",
      "    },",
      "    enabled: !!${4:id},",
      "    staleTime: 5 * 60 * 1000, // 5 minutes",
      "  });",
      "};",
      "",
      "export default use${3:FeatureName}Data;"
    ],
    "description": "MWAP Client React Query hook template"
  },
  "MWAP Mutation Hook": {
    "prefix": "mwap-mutation",
    "body": [
      "import { useMutation, useQueryClient } from '@tanstack/react-query';",
      "import { notifications } from '@mantine/notifications';",
      "import { apiClient } from '@/shared/utils/api';",
      "",
      "interface ${1:InputType} {",
      "  ${2:// Input interface}",
      "}",
      "",
      "const use${3:FeatureName}Mutation = () => {",
      "  const queryClient = useQueryClient();",
      "",
      "  return useMutation({",
      "    mutationFn: async (data: ${1:InputType}) => {",
      "      const response = await apiClient.${4:post}('/api/v1/${5:feature}', data);",
      "      return response.data;",
      "    },",
      "    onSuccess: () => {",
      "      queryClient.invalidateQueries({ queryKey: ['${5:feature}'] });",
      "      notifications.show({",
      "        title: 'Success',",
      "        message: '${6:Operation completed successfully}',",
      "        color: 'green',",
      "      });",
      "    },",
      "    onError: (error) => {",
      "      notifications.show({",
      "        title: 'Error',",
      "        message: error.message,",
      "        color: 'red',",
      "      });",
      "    },",
      "  });",
      "};",
      "",
      "export default use${3:FeatureName}Mutation;"
    ],
    "description": "MWAP Client mutation hook template"
  },
  "MWAP Zod Schema": {
    "prefix": "mwap-schema",
    "body": [
      "import { z } from 'zod';",
      "",
      "export const ${1:schemaName}Schema = z.object({",
      "  ${2:name}: z.string().min(1, '${3:Name is required}'),",
      "  ${4:email}: z.string().email('${5:Invalid email format}'),",
      "  ${6:// Additional fields}",
      "});",
      "",
      "export type ${7:SchemaType} = z.infer<typeof ${1:schemaName}Schema>;"
    ],
    "description": "MWAP Client Zod validation schema"
  },
  "MWAP Form Component": {
    "prefix": "mwap-form",
    "body": [
      "import React from 'react';",
      "import { useForm, zodResolver } from '@mantine/form';",
      "import { Button, TextInput, Stack } from '@mantine/core';",
      "import { z } from 'zod';",
      "",
      "const ${1:formName}Schema = z.object({",
      "  ${2:name}: z.string().min(1, '${3:Name is required}'),",
      "  ${4:// Additional fields}",
      "});",
      "",
      "type ${5:FormData} = z.infer<typeof ${1:formName}Schema>;",
      "",
      "interface ${6:FormComponent}Props {",
      "  onSubmit: (data: ${5:FormData}) => void;",
      "  ${7:// Additional props}",
      "}",
      "",
      "const ${6:FormComponent}: React.FC<${6:FormComponent}Props> = ({",
      "  onSubmit,",
      "  ${8:// Destructured props}",
      "}) => {",
      "  const form = useForm({",
      "    validate: zodResolver(${1:formName}Schema),",
      "    initialValues: {",
      "      ${2:name}: '',",
      "      ${9:// Initial values}",
      "    },",
      "  });",
      "",
      "  const handleSubmit = (values: ${5:FormData}) => {",
      "    onSubmit(values);",
      "  };",
      "",
      "  return (",
      "    <form onSubmit={form.onSubmit(handleSubmit)}>",
      "      <Stack>",
      "        <TextInput",
      "          label=\"${10:Name}\"",
      "          placeholder=\"${11:Enter name}\"",
      "          {...form.getInputProps('${2:name}')}",
      "        />",
      "        ${12:// Additional form fields}",
      "        <Button type=\"submit\">",
      "          ${13:Submit}",
      "        </Button>",
      "      </Stack>",
      "    </form>",
      "  );",
      "};",
      "",
      "export default ${6:FormComponent};"
    ],
    "description": "MWAP Client form component with validation"
  },
  "MWAP Protected Route": {
    "prefix": "mwap-protected",
    "body": [
      "import React from 'react';",
      "import { useAuth0 } from '@auth0/auth0-react';",
      "import { useRoles } from '@/core/context/AuthContext';",
      "import { LoadingSpinner } from '@/shared/components/LoadingSpinner';",
      "import { UnauthorizedMessage } from '@/shared/components/UnauthorizedMessage';",
      "",
      "interface ${1:ComponentName}Props {",
      "  ${2:// Props interface}",
      "}",
      "",
      "const ${1:ComponentName}: React.FC<${1:ComponentName}Props> = ({",
      "  ${3:// Destructured props}",
      "}) => {",
      "  const { isAuthenticated, isLoading } = useAuth0();",
      "  const { hasRole } = useRoles();",
      "",
      "  if (isLoading) {",
      "    return <LoadingSpinner />;",
      "  }",
      "",
      "  if (!isAuthenticated) {",
      "    return <UnauthorizedMessage message=\"Please log in to access this page\" />;",
      "  }",
      "",
      "  if (!hasRole('${4:REQUIRED_ROLE}')) {",
      "    return <UnauthorizedMessage message=\"You don't have permission to access this page\" />;",
      "  }",
      "",
      "  return (",
      "    <div>",
      "      ${5:// Protected content}",
      "    </div>",
      "  );",
      "};",
      "",
      "export default ${1:ComponentName};"
    ],
    "description": "MWAP Client protected route component"
  },
  "MWAP Feature Index": {
    "prefix": "mwap-feature-index",
    "body": [
      "// ${1:FeatureName} Feature Exports",
      "",
      "// Types",
      "export type * from './types';",
      "",
      "// Hooks",
      "export { default as use${1:FeatureName}Data } from './hooks/use${1:FeatureName}Data';",
      "export { default as use${1:FeatureName}Mutation } from './hooks/use${1:FeatureName}Mutation';",
      "",
      "// Pages",
      "export { default as ${1:FeatureName}List } from './pages/${1:FeatureName}List';",
      "export { default as ${1:FeatureName}Detail } from './pages/${1:FeatureName}Detail';",
      "export { default as ${1:FeatureName}Form } from './pages/${1:FeatureName}Form';",
      "",
      "// Components",
      "export { default as ${1:FeatureName}Card } from './components/${1:FeatureName}Card';",
      "export { default as ${1:FeatureName}Table } from './components/${1:FeatureName}Table';"
    ],
    "description": "MWAP Client feature index file template"
  },
  "MWAP Error Boundary": {
    "prefix": "mwap-error-boundary",
    "body": [
      "import React, { Component, ErrorInfo, ReactNode } from 'react';",
      "import { Alert, Button, Stack, Text } from '@mantine/core';",
      "import { IconAlertCircle } from '@tabler/icons-react';",
      "",
      "interface Props {",
      "  children: ReactNode;",
      "  fallback?: ReactNode;",
      "}",
      "",
      "interface State {",
      "  hasError: boolean;",
      "  error?: Error;",
      "}",
      "",
      "class ${1:ErrorBoundary} extends Component<Props, State> {",
      "  public state: State = {",
      "    hasError: false,",
      "  };",
      "",
      "  public static getDerivedStateFromError(error: Error): State {",
      "    return { hasError: true, error };",
      "  }",
      "",
      "  public componentDidCatch(error: Error, errorInfo: ErrorInfo) {",
      "    console.error('Error caught by boundary:', error, errorInfo);",
      "  }",
      "",
      "  private handleReset = () => {",
      "    this.setState({ hasError: false, error: undefined });",
      "  };",
      "",
      "  public render() {",
      "    if (this.state.hasError) {",
      "      if (this.props.fallback) {",
      "        return this.props.fallback;",
      "      }",
      "",
      "      return (",
      "        <Alert",
      "          icon={<IconAlertCircle size={16} />}",
      "          title=\"Something went wrong\"",
      "          color=\"red\"",
      "        >",
      "          <Stack>",
      "            <Text size=\"sm\">",
      "              An error occurred while rendering this component.",
      "            </Text>",
      "            <Button size=\"sm\" onClick={this.handleReset}>",
      "              Try Again",
      "            </Button>",
      "          </Stack>",
      "        </Alert>",
      "      );",
      "    }",
      "",
      "    return this.props.children;",
      "  }",
      "}",
      "",
      "export default ${1:ErrorBoundary};"
    ],
    "description": "MWAP Client error boundary component"
  },
  "MWAP API Types": {
