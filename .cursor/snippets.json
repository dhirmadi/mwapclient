      "export interface Update${2:EntityName}Request {",
      "  ${3:name}?: string;",
      "  ${6:// Optional fields for update}",
      "}",
      "",
      "export interface ${2:EntityName}ListResponse {",
      "  data: ${2:EntityName}[];",
      "  total: number;",
      "  page: number;",
      "  limit: number;",
      "}",
      "",
      "export interface ${2:EntityName}Response {",
      "  data: ${2:EntityName};",
      "}"
    ],
    "description": "MWAP Client API types template"
  }
}